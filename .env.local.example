# ==========================================
# NIGHTWIRE VIDEO STUDIO - ENVIRONMENT CONFIG
# Free-Tier Stack: Cloudflare R2 + Supabase
# ==========================================

# Supabase Free Tier (PostgreSQL + Auth, 500MB DB)
# Retrieve from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Cloudflare R2 (10GB Free Storage, Zero Egress Fees)
# Retrieve from: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="nightwire-videos"

# Public R2 delivery endpoint (Direct range-request streaming)
# Custom domain or r2.dev public bucket URL
NEXT_PUBLIC_R2_PUBLIC_URL="https://pub-your-id.r2.dev"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Gemini API Key
GEMINI_API_KEY=""
